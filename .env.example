# ── Scholar's Kingdom · local environment ─────────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env — it is git-ignored for a reason.

# SQLite database (schema-relative path — resolves next to prisma/schema.prisma)
DATABASE_URL=file:../db/custom.db

# CARTO basemap tile key (get yours free at https://carto.com — "Build a new app")
# Used client-side for map tiles. Optional: without it, kingdoms still render
# on a plain canvas, just without the street basemap.
NEXT_PUBLIC_CARTO_KEY=your_carto_api_key_here
